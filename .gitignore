# ------------------------------
# Local dependency checkouts/caches
# Keep SLAM/vcpkg.json under version control; bootstrap vcpkg separately.
# ------------------------------
SLAM/vcpkg/
SLAM/vcpkg_installed/
SLAM/Pangolin/

# ORBvoc is a large generated/downloaded vocabulary, not project source.
SLAM/ORB_SLAM3/Vocabulary/ORBvoc.txt
SLAM/ORB_SLAM3/Vocabulary/ORBvoc.txt.tar.gz

# Upstream ORB-SLAM3 example/evaluation datasets are not required by this
# project's SVO2 runner. Keep the source code and custom example intact.
SLAM/ORB_SLAM3/Examples_old/
SLAM/ORB_SLAM3/Examples/Monocular-Inertial/TUM_IMU/
SLAM/ORB_SLAM3/Examples/Stereo-Inertial/TUM_IMU/
SLAM/ORB_SLAM3/evaluation/

# Temporary files created by interrupted exports.
*.tmp
*.part
*.bak
